        "label": "Left",
        "value": "left"
      },
      {
        "label": "Centre (default)",
        "value": "center"
      },
      {
        "label": "Right",
        "value": "right"
      },
      {
        "label": "Full width",
        "value": "full"
      }
    ]
  },
  {
    "property": "zen.mods.container-badge.max-width",
